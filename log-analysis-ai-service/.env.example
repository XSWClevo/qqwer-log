# ===================================
# Claude API配置（必填）
# ===================================
# API Base URL（可选，默认使用官方API）
# 如果使用代理或自建服务，请设置此项
ANTHROPIC_BASE_URL=https://api.anthropic.com

# API Key（必填）
# 获取方式：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Claude模型配置（可选）
# 可选值：
# - claude-sonnet-4-5-thinking (推荐)
# - claude-sonnet-4-5-opus (最强)
# - claude-3-5-sonnet-20241022 (性价比高)
# - claude-3-opus-20240229 (最强，但贵)
# - claude-3-haiku-20240307 (最快最便宜)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 默认模型配置（可选）
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-3-opus-20240229
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-3-5-sonnet-20241022

# ===================================
# 服务配置（可选）
# ===================================
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO

# ===================================
# SQL生成配置（可选）
# ===================================
# SQL Agent最大迭代次数
MAX_ITERATIONS=3
# 最大执行时间（秒）
MAX_EXECUTION_TIME=30
# 最大返回结果行数
MAX_RESULT_ROWS=1000
